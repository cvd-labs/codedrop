{
  "manifest_version": 3,
  "name": "CodeDrop",
  "version": "0.3.5",
  "minimum_chrome_version": "120",
  "description": "Offers the verification code from your Gmail right next to the code box. You click Fill. On-device prototype.",
  "action": {
    "default_title": "CodeDrop",
    "default_popup": "toolbar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "setup.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "identity", "declarativeContent"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "content_scripts": [
